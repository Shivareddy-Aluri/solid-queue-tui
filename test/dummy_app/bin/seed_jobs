#!/usr/bin/env ruby
# frozen_string_literal: true

# Quick script to enqueue more jobs into the running app.
# Useful for testing the TUI with live data flowing in.
#
# Usage:
#   bin/seed_jobs             # enqueue a default batch
#   bin/seed_jobs --count 50  # enqueue 50 random jobs
#   bin/seed_jobs --failing   # enqueue only failing jobs
#   bin/seed_jobs --loop      # continuously enqueue jobs (1 per second)

require_relative "../config/environment"

count = 10
failing_only = false
loop_mode = false

ARGV.each_with_index do |arg, i|
  case arg
  when "--count"
    count = ARGV[i + 1].to_i
  when "--failing"
    failing_only = true
  when "--loop"
    loop_mode = true
  end
end

JOBS = [
  -> { ProcessOrderJob.perform_later(rand(1000..9999)) },
  -> { SendNotificationJob.perform_later(rand(1..500), "Test notification at #{Time.now}") },
  -> { UrgentAlertJob.perform_later(%w[security payment system].sample, "Test alert") },
  -> { GenerateReportJob.perform_later(%w[sales inventory users].sample, Date.today.to_s) },
  -> { DataExportJob.perform_later(%w[csv json].sample, rand(1..100)) },
  -> { WarmCacheJob.perform_later("test:#{SecureRandom.hex(4)}") },
  -> { ScheduledCleanupJob.set(wait: rand(1..30).minutes).perform_later(rand(7..90)) },
  -> { SyncInventoryJob.perform_later("SKU-#{rand(1..10).to_s.rjust(3, '0')}") }
].freeze

FAILING = [
  -> { FailingJob.perform_later(rand(0..5)) }
].freeze

enqueue = ->(n) do
  pool = failing_only ? FAILING : JOBS
  n.times do |i|
    pool.sample.call
    print "."
  end
  puts " #{n} jobs enqueued!"
end

if loop_mode
  puts "Continuously enqueuing jobs (Ctrl+C to stop)..."
  loop do
    (failing_only ? FAILING : JOBS).sample.call
    print "."
    sleep 1
  rescue Interrupt
    puts "\nStopped."
    break
  end
else
  puts "Enqueuing #{count} #{failing_only ? 'failing ' : ''}jobs..."
  enqueue.call(count)
end
