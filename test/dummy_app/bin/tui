#!/usr/bin/env ruby
# frozen_string_literal: true

# Launch the Solid Queue TUI pointed at this app's queue database.
#
# Usage:
#   bin/tui              # launch the dashboard
#   bin/tui --refresh 5  # custom refresh interval

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
FileUtils.chdir(APP_ROOT)

# Determine the queue database path
queue_db = File.join(APP_ROOT, "storage", "queue.sqlite3")

unless File.exist?(queue_db)
  $stderr.puts "Queue database not found at #{queue_db}"
  $stderr.puts "Run 'bin/setup' first to create it."
  exit 1
end

# Add the gem's lib to the load path
gem_lib = File.expand_path("../../../lib", __dir__)
$LOAD_PATH.unshift(gem_lib)

ENV["DATABASE_URL"] = "sqlite3:#{queue_db}"

require "solid_queue_tui"

puts "Launching Solid Queue TUI..."
puts "Database: #{queue_db}"
puts "Press 'q' to quit, '?' for help"
puts ""

SolidQueueTui::Application.new(
  database_url: ENV["DATABASE_URL"],
  refresh_interval: ARGV.include?("--refresh") ? ARGV[ARGV.index("--refresh") + 1].to_i : 2,
  dev: true
).run
